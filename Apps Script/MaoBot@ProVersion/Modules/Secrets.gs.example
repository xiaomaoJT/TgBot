/**
 * ============================================================================
 *  MaoBot · ProVersion — 私密配置模板（✅ 可提交仓库）
 * ============================================================================
 *
 *  这是占位模板。复制它成 Modules/Secrets.gs 并填入【你自己的】值：
 *      cp Modules/Secrets.gs.example Modules/Secrets.gs
 *
 *  Modules/Secrets.gs 已被 .gitignore 排除，不会进公开仓库。
 *  仓库里 Modules/Params.gs 只保留空占位，真实值由 Secrets.gs 在运行时覆盖回去。
 */

var PROJECT_SECRETS = {
  EXECID: "",       // Google 表格 ID（网址 /d/ 与 /edit 之间那一串）
  BOTID: "",        // Telegram Bot Token（@BotFather 给的，形如 123456:AAE...）
  KingId: "",       // 你的 Telegram 数字 ID（私聊机器人发 /id 获取）
  botIdAlone: "",   // 机器人自身数字 ID（填错只轻微降级，不报错）
  geminiKey: "",    // Gemini API Key（aistudio.google.com，免费 1500 次/天）
  webappUrl: "",    // Web 应用地址（留空 = 自动解析，推荐）
};

EXECID = PROJECT_SECRETS.EXECID;
BOTID = PROJECT_SECRETS.BOTID;
KingId = PROJECT_SECRETS.KingId;
botIdAlone = PROJECT_SECRETS.botIdAlone;
CONFIG.ai.geminiKey = PROJECT_SECRETS.geminiKey;
CONFIG.deploy.webappUrl = PROJECT_SECRETS.webappUrl;
